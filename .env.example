# =====================================================================
# EV Charging Dashboard — environment variables
# Copy this file to .env (local dev) and set the same keys in
# Netlify → Site configuration → Environment variables for production.
# Never commit a real .env file.
# =====================================================================

# --- Supabase (required) -----------------------------------------------
# Project URL and anon (public) key, from Supabase → Project settings → API.
# The anon key is safe to expose to the browser — access is controlled by
# the Row Level Security policies in supabase/migrations/0001_init.sql,
# which require a logged-in (Supabase Auth) user for any read/write.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER-SIDE ONLY. Used by Netlify Functions
# (netlify/functions/*) to write cached electricity prices and to run
# recalculations. Never prefix this with VITE_ and never ship it to the
# browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Electricity price source (required) --------------------------------
# Default: Energi Data Service (official Danish TSO open data API, no key
# required). https://www.energidataservice.dk/
ELECTRICITY_PRICE_API_URL=https://api.energidataservice.dk/dataset/Elspotprices
ELECTRICITY_PRICE_AREA=DK2
VITE_ELECTRICITY_PRICE_AREA=DK2

# --- Optional -------------------------------------------------------------
# Set to "true" to make the price-fetch function return deterministic mock
# data instead of calling the live API (useful for local dev/testing).
USE_MOCK_PRICE_SOURCE=false
